# ---------------------------------------------------------------
# User-uploaded content. NEVER commit these - they contain PII
# (NIN cards, guarantor passports, signatures, payment receipts).
# NOTE: public/build also holds hand-authored site assets
# (css/, js/, vendor/, image/logo, image/gallery, image/slider*),
# so it is deliberately NOT ignored wholesale.
# ---------------------------------------------------------------
# Matched at ANY depth under public/ - these trees are duplicated in
# build/, build2/, and a nested assets/image/image/ copy.
/public/**/idcards/
/public/**/passports/
/public/**/signatures/
/public/**/guarantors/
/public/**/profile_photo/
/public/**/profile_photo_path/
/public/**/receipt/
/public/**/bank_receipts/
/public/**/image.zip
/build/**/idcards/
/build/**/passports/
/build/**/signatures/
/build/**/guarantors/
/build/**/profile_photo/
/build/**/profile_photo_path/
/build/**/receipt/

# Storage-disk uploads
/storage/app/private
/storage/app/public

# OS noise
.DS_Store
Thumbs.db

# Generated package/service manifests
/bootstrap/cache/*.php

# Stray duplicate of public/build - a 274-byte manifest.json here (app.css/app.js
# only, no ui entries) was uploaded over the real one and took the live site down
# with "Unable to locate file in Vite manifest". Nothing references this path.
/build/

# One-off server diagnostic - never commit or deploy
/whereami.php
